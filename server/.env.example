# =========================================================
# APSCHE BACKEND ENVIRONMENT
# =========================================================

# Server
PORT=5000

# MongoDB
# Replace this with your own MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/apsche_practice

# Authentication
# Use a long random secret in your real deployment.
JWT_SECRET=replace_with_a_long_random_secret

# JWT expiration
JWT_EXPIRES_IN=7d

# Frontend URL
CLIENT_URL=http://localhost:5173

# Application environment
NODE_ENV=development
